{% extends 'base.html.twig' %}

{% block title %}Bienvenue
{% endblock %}

{% block body %}

	{% for message in app.flashes('success') %}
		<div class="alert alert-success mt-4">
			{{ message }}
		</div>
	{% endfor %}
	
	<div class="container">
		<div class="col-12 text-center mt-4">
			<h1 class="title-style">NOS BONS PLANS</h1>
		</div>

		<div class="row justify-content-center">

			{% for promo in promos %}
				<div class="col-md-3 col-12 mt-4">

					<div class="card text-white bg-primary mb-4 custom-card">

						<div class="card-header d-flex justify-content-center h2">{{ promo.title }}</div>
						<div class="card-body d-flex flex-column align-items-center justify-content-center">

							{% if promo.imageName %}
								<img src="{{ vich_uploader_asset(promo, 'imageFile') }}" style="width:200px; height: 200px;" class="img-fluid" alt="{{ promo.title }}">
							{% else %}

								<img src="/images/placeholder.jpg" style="width:200px; height: 200px;" class="img-fluid" alt="Image indisponible">
							{% endif %}


							<p class="card-text text-center">{{ promo.description }}</p>
							<p class="card-text text-center">{{ promo.prix|number_format(2, ',', ' ') }}
								€</p>
						</div>
						{% if is_granted('ROLE_ADMIN') %}
							<div class="d-flex flex-column align-items-center">
								<a href="{{ path('edit_promo', { id: promo.id }) }}" class="btn btn-dark btn mb-2">Modifier</a>
								<a href="{{ path('delete_promo', { id: promo.id }) }}" class="btn btn-danger btn-sm">Supprimer</a>
							</div>
						{% endif %}
					</div>


				</div>
			{% endfor %}
		</div>
	</div>
{% endblock %}
