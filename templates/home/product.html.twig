{% extends 'base.html.twig' %}

{% block title %}
	{{ category.name }}
{% endblock %}

{% block body %}

<div class="content-container">
	<div
		class="row">
		{# {% if category.name == "FRUITS" %}
									<img src="/images/accueil/accueilfruits.jpg" class="img-fluid custom-img-height" alt="Fruits">
								{% elseif category.name == "LEGUMES" %}
									<img src="/images/accueil/accueillegumes.jpg" class="img-fluid custom-img-height" alt="Légumes">
								{% elseif category.name == "EPICERIE" %}
									<img src="/images/accueil/accueilepiceS.jpg" class="img-fluid custom-img-height" alt="Épicerie">
								{% endif %} #}
		<div class="col-12">

			<h1 class="dispaly-2 text-primary text-center">{{ category.name }}
			</h1>
			<hr class="my-2">

			<div class="container">
				<div class="row">
					{% for product in products %}
						<div class="col-md-3 mb-4">
							<div class="card h-100 d-flex flex-row">
								{% if product.imageName %}
									<div class="product">
										<a href="{{ path("app_detail", { id: product.id }) }}">
											<img style="width: 150px; height: 150px;" src="{{ vich_uploader_asset(product, 'imageFile') }}">
										</a>
									</div>
								{% else %}
									<div>
										{% if category.imagesrc %}
											<a href="{{ path("app_detail", { id: product.id }) }}">
												<img style="max-width:150px; height: 150px;" src="/images/categorie/{{ category.imagesrc }}">
											</a>
										{% else %}
											<img style="max-width:200px; height: 200px;" src="/images/placeholder.jpg" alt="">
										{% endif %}
									</div>
								{% endif %}
								<div class="card-body d-flex flex-column">
									<div>
										<h5 class="card-title">{{ product.name }}</h5>

									</div>
									<a href="{{ path("app_detail", { id: product.id }) }}" class="mt-auto btn btn-outline-primary btn-sm">Voir le détail</a>
								</div>
							</div>
						</div>


					{% endfor %}
				</div>
				<div class="text-end">
					<a href="{{ path("app_category", { id: category.id }) }}" class="btn btn-primary btn-lg mb-4" title="Revenir à la catégorie précédente">Retour à Nos produits</a>
				</div>
			</div>
			<div class="navigation d-flex justify-content-center">{{ knp_pagination_render(products) }}</div>

			<div class="row"></div>
			<div id="carouselExampleAutoplaying" class="carousel slide" data-bs-ride="carousel">
				<h2 class="text-center text-primary mt-4">Nos services !</h2>
				<div class="carousel-inner">
					<div class="carousel-item active">
						<img src="/images/caroussel1.jpg" class="d-block w-100" alt="...">
					</div>
					<div class="carousel-item">
						<img src="/images/caroussel2.jpg" class="d-block w-100" alt="...">
					</div>
					<div class="carousel-item">
						<img src="/images/caroussel3.jpg" class="d-block w-100" alt="...">
					</div>
				</div>
				<button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleAutoplaying" data-bs-slide="prev">
					<span class="carousel-control-prev-icon" aria-hidden="true"></span>
					<span class="visually-hidden">Previous</span>
				</button>
				<button class="carousel-control-next" type="button" data-bs-target="#carouselExampleAutoplaying" data-bs-slide="next">
					<span class="carousel-control-next-icon" aria-hidden="true"></span>
					<span class="visually-hidden">Next</span>
				</button>
				<br>
			</div>
		</div>
		< </div> {% endblock %}
