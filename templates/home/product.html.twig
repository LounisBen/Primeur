{% extends 'base.html.twig' %}

{% block title %}
	{{ category.name }}
{% endblock %}

{% block body %}

	<div class="content-container" style="margin-top: 50px;">
		<div class="row">
			<div class="col-12">

				<h1 class="dispaly-2 text-primary text-center">{{ category.name }}
				</h1>
				<hr class="my-2">

				<div class="container">
					<div class="row">
						{% for product in products %}
							<div class="col-md-6 mb-4">
								<div class="card h-100 d-flex flex-row">
									{% if product.imageName %}
										<div class="produitImage">
											<a href="{{ path("app_detail", { id: product.id }) }}">
												<img style="width: 200px; height: 200px;" src="{{ vich_uploader_asset(image, 'imageFile') }}">
											</a>
										</div>
									{% else %}
										<div>
											{% if category.imagesrc %}
												<a href="{{ path("app_detail", { id: product.id }) }}">
													<img style="max-width:200px; height: 200px;" src="/images/categorie/{{ category.imagesrc }}">
												</a>
											{% else %}
												<img style="max-width:200px; height: 200px;" src="/images/placeholder.jpg" alt="">
											{% endif %}
										</div>
									{% endif %}
									<div class="card-body d-flex flex-column">
										<div>
											<h5 class="card-title">{{ product.name }}</h5>
											<p class="card-text">{{ product.description }}</p>
										</div>
										<a href="{{ path("app_detail", { id: product.id }) }}" class="mt-auto btn btn-outline-primary btn-sm">Voir le détail</a>
									</div>
								</div>
							</div>
						{% endfor %}
					</div>
				</div>
                 <div class="navigation d-flex justify-content-center">{{ knp_pagination_render(products) }}</div>
			</div>
		</div>
	</div>
{% endblock %}
