{% extends 'base.html.twig' %}

{% block title %}Nos produits
{% endblock %}

{% block body %}
	<div class="container">
		
			<div class="col-12 text-center mt-4">
				<h1 class="title-style">Nos rayons</h1>
			</div>
		

		<div class="row justify-content-center">
			
			{% for cat in categories %}
				<div class="col-md-4 mt-4">
					<a href="{{ path("app_product", {id: cat.id}) }}">
						<div class="card text-white bg-primary mb-4 custom-card">

							<div class="card-header d-flex justify-content-center h2">{{ cat.name }}</div>
							<div class="card-body d-flex flex-column align-items-center justify-content-center">
								<img src="/images/categorie/{{ cat.imagesrc }}" alt="categorie" class="img-fluid">
								<p class="card-text">{{ cat.content }}</p>
							</div>
						</div>

					</a>
				</div>
			{% endfor %}
		</div>
		<div class="row">
		<div id="carouselExampleAutoplaying" class="carousel slide" data-bs-ride="carousel">
			<h2 class="text-center text-primary mt-4">Nos services !</h2>
			<div class="carousel-inner">
				<div class="carousel-item active">
					<img src="/images/caroussel/caroussel1.webp" class="d-block w-100" alt="...">
				</div>
				<div class="carousel-item">
					<img src="/images/caroussel/caroussel2.webp" class="d-block w-100" alt="...">
				</div>
				<div class="carousel-item">
					<img src="/images/caroussel/caroussel3.webp" class="d-block w-100" alt="...">
				</div>
			</div>
			<button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleAutoplaying" data-bs-slide="prev">
				<span class="carousel-control-prev-icon" aria-hidden="true"></span>
				<span class="visually-hidden">Previous</span>
			</button>
			<button class="carousel-control-next" type="button" data-bs-target="#carouselExampleAutoplaying" data-bs-slide="next">
				<span class="carousel-control-next-icon" aria-hidden="true"></span>
				<span class="visually-hidden">Next</span>
			</button>
			<br>
		</div>
		</div>
	</div>
</div>{% endblock %}
