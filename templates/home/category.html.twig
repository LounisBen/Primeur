{% extends 'base.html.twig' %}

{% block title %}Welcome
{% endblock %}

{% block body %}

	
	<div class="row row-cols-1 row-cols-md-3 row-cols-lg-3 justify-content-center g-4">
		{% for cat in categories %}
			<div class="col mt-5">
				<a href="{{ path("app_product", {id: cat.id}) }}">
					<div class="card text-white bg-primary mb-4 custom-card">

						<div class="card-header d-flex justify-content-center h2">{{ cat.name }}</div>
						<div class="card-body d-flex flex-column align-items-center justify-content-center">
							<img src="/images/categorie/{{ cat.imagesrc }}" alt="categorie" style="max-height: 100%; width: 100%;">
							<p class="card-text text-center">{{ cat.content }}</p>
						</div>
					</div>

				</a>
			</div>
		{% endfor %}
	</div>


</div>{% endblock %}
