{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
    <div class="content-container">
        {% for message in app.flashes('success') %}
            <div class="alert alert-success mt-4">
                {{ message }}
            </div>
        {% endfor %}

        <div class="container">
            
            <div class="row">
                <div class="col-12 text-center mt-4">
                    <h1 class="title-style">BIENVENUE CHEZ LE PRIMEUR DE LAIGNEVILLE</h1>
                </div>
            </div>

            <div class="row">
                
                <div class="col-12">
                    <p class="lead text-primary">
                        <strong>Maraîcher, c'est une histoire de famille chez nous. Nous vous proposons des fruits et légumes, de qualité à prix accessible pour tous, crèmerie et épicerie.</strong>
                        <br><br>
                        <strong>Nous sommes un commerce de proximité, de fruits et légumes, proposant également un rayon épicerie et des produits de consommation courante pour vous faire gagner du temps.</strong>
                    </p>
                    
                </div>

                
                <div class="col-md-12">
                    <p class="lead text-primary mt-4">
                        <strong>Adresse :</strong> 285 rue André Gourdin, 60290 Laigneville<br>
                        <strong>Horaires :</strong>

                        {% set timezone = 'Europe/Paris' %}
                        {% set current_time = "now"|date("H:i", timezone) %}
                        {% set open_time = "10:00" %}
                        {% set close_time = "20:00" %}
                        {% set current_day = "now"|date("l", timezone) %}

                        <ul>
                            <li>Lundi : Fermé</li>
                            <li>Mardi - Dimanche : {{ open_time }} - {{ close_time }}</li>
                        </ul>
                        <span class="{% if current_day == 'Monday' %}text-danger{% elseif current_time >= open_time and current_time < close_time %}text-success{% else %}text-danger{% endif %}">
                        {% if current_day == "Monday" %}
                            Fermé aujourd'hui.
                        {% else %}
                            {% if current_time >= open_time and current_time < close_time %}
                                Ouvert maintenant.
                            {% else %}
                                Fermé maintenant.
                            {% endif %}
                        {% endif %}
                    </p>
                </div>
            </div>

            <hr class="my-4">
            <h2 class="text-primary text-center">Où Nous Trouver</h2>
            <div class="map-container mb-4">
					<iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2602.131894864901!2d2.4453474768082395!3d49.292844570034056!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47e64b3a814c1183%3A0xb1a98a64a81d629a!2sPrimeur%20de%20Laigneville!5e0!3m2!1sfr!2sfr!4v1702225213208!5m2!1sfr!2sfr" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
			
            </div>
            <a class="btn btn-primary btn-lg" href="{{ path('app_registration') }}" role="button">Inscription</a>
        </div>
        
    </div>
	<div style="height: 80px;"></div>
{% endblock %}