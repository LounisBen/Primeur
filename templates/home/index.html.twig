{% extends 'base.html.twig' %}

{% block title %}Accueil
{% endblock %}

{% block body %}
	<div class="content-container">

		{% for message in app.flashes('success') %}
			<div class="alert alert-success mt-4">
				{{ message }}
			</div>
		{% endfor %}


		<div class="row">
			<img src="/images/accueil/accueil.jpg" class="img-fluid" alt="...">

			<div>
				<center>
					<h1 class="dispaly-1 text-primary text-center">BIENVENUE CHEZ LE PRIMEUR DE LAIGNEVILLE</h1>
				</center>
				<p class="lead text-primary">Vente de fruits et légumes à prix accessible pour tous, crèmerie et épicerie.</p>
				<hr class="my-2">
				<p class="lead text-primary">
					Nous sommes un commerce de fruits et légumes, proposant également un rayon épicerie et des produits de consommation courante pour vous faire gagner du temps.
				</p>
				<p class="lead text-primary">
					<strong>Adresse :</strong>
					285 rue André Gourdin, 60290 Laigneville<br>
					<strong>Horaires :</strong>
					Vos horaires ici
				</p>
				
				<hr class="my-4">
				<h2 class="text-primary text-center">Où Nous Trouver</h2>
				<div class="map-container">
					<iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2602.131894864901!2d2.4453474768082395!3d49.292844570034056!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47e64b3a814c1183%3A0xb1a98a64a81d629a!2sPrimeur%20de%20Laigneville!5e0!3m2!1sfr!2sfr!4v1702225213208!5m2!1sfr!2sfr" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
				</div>
			</div>

		</div>
	{% endblock %}
