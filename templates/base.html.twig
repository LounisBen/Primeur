<!DOCTYPE html>
<html lang="fr">

    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href='data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%20128%20128%22%3E%3Ctext%20y=%221.2em%22%20font-size=%2296%22%3E⚫️%3C/text%3E%3C/svg%3E'>


        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="description" content="Votre magasin de fruits, légumes, et épicerie vous propose des produits frais, de qualité, des produits locaux, et la possiblité de vous livrer.">
        
        {% block stylesheets %}
            <link rel="stylesheet" href="/bootstrap.min.css">
            <link rel="stylesheet" href="/_variables.scss">
            <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css">
            <link rel="stylesheet" href="/style.css" media="print" onload="this.media='all'">

        {% endblock %}
            
        {% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.9.2/dist/umd/popper.min.js" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.1/dist/js/bootstrap.min.js" defer integrity="sha384-Atwg2Pkwv9vp0ygtn1JAojH0nYbwNJLPhwyoVbhoPwBhjQPR5VtM2+xf0Uwh9KtT" crossorigin="anonymous"></script>
    <script src="https://kit.fontawesome.com/77b6e6294c.js" defer crossorigin="anonymous"></script>
{% endblock %}

    </head>
    <body>
        
        <img src="/images/accueil/fond.webp" class="img-fluid img-accueil" alt="Primeur de Laigneville">
        
        {{ render(controller('App\\Controller\\NavController::index')) }}
        {% block body %}
        {% endblock %}
        
        {% block footer %}        
            {% include "partials/_footer.html.twig" %}
            
        {% endblock %}
    </body>
</html>
