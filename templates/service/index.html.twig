{% extends 'base.html.twig' %}

{% block title %}Services
{% endblock %}

{% block body %}
	<div class="container mt-5">
		<div class="col-12 text-center mt-4">
			<h1 class="title-style">Nos services</h1>
		</div>

		<div class="row">

			<div class="col-md-6 col-lg-3 mb-4">
				<div class="card h-100">
					<img src="/images/services/corbeille1.webp" class="card-img-top" alt="Fruits de saison">
					<div class="card-body">
						<h5 class="card-title">Corbeille de fruits de saison</h5>
						<p class="card-text">Découvrez notre sélection de fruits frais de saison.</p>
						<p>25 €</p>
					</div>
				</div>
			</div>


			<div class="col-md-6 col-lg-3 mb-4">
				<div class="card h-100">
					<img src="/images/services/corbeille2.webp" class="card-img-top" alt="Fruits exotiques">
					<div class="card-body">
						<h5 class="card-title">Corbeille de fruits exotiques</h5>
						<p class="card-text">Savourez une variété de fruits exotiques uniques.</p>
						<p>35 €</p>
					</div>
				</div>
			</div>


			<div class="col-md-6 col-lg-3 mb-4">
				<div class="card h-100">
					<img src="/images/services/plateaufruits.webp" class="card-img-top" alt="Fruits à la carte">
					<div class="card-body">
						<h5 class="card-title">Plateau de fruits decoupés</h5>
						<p class="card-text">Composez votre plateau de fruits découpés ou votre panier de fruits.</p>
						<p>Sur commande</p>
					</div>
				</div>
			</div>


			<div class="col-md-6 col-lg-3 mb-4">
				<div class="card h-100">
					<img src="/images/services/livraison.webp" class="card-img-top" alt="Livraison">
					<div class="card-body">
						<h5 class="card-title">Livraison</h5>
						<p class="card-text">Profitez de notre service de livraison offerte dans un périmetre de 25 km.</p>
						<p>5 € à partir de 30 € d'achat</p>
					</div>
				</div>
			</div>
			<div class="text-center mt-4" style="height: 80px;">
				<p>Pour toute demande, appelez le 06.72.80.99.94
				</p>
			</div>
		</div>
	</div>
{% endblock %}
